# Credenciais OAuth do Google Cloud (tipo "App para computador")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gerado por: node auth.js
GOOGLE_REFRESH_TOKEN=

# Segredo que vira parte da URL do MCP. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_SECRET=

# Opcional
TIMEZONE=America/Recife
ENABLE_TURN_IN=false
